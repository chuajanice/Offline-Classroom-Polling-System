{
  "name": "offline-classroom-polling",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:init": "prisma migrate dev --name init --create-only && node scripts/append-checks.mjs && prisma migrate dev && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:verify": "tsx scripts/verify-phase1.ts",
    "test": "tsx --test --test-reporter=spec tests/**/*.test.ts",
    "test:unit": "tsx --test --test-reporter=spec tests/unit/**/*.test.ts",
    "smoke:auth": "node scripts/smoke-auth.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
