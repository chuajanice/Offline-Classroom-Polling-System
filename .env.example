# Copy this file to .env and replace the placeholder password.
# .env must never be committed.
#
# If the password contains special characters (@ : / ? # % etc.) they must be
# percent-encoded in the URL, e.g. "p@ss" -> "p%40ss".

# Application + Prisma CLI database.
DATABASE_URL="mysql://polling_app:sjjm@ctuG!26@localhost:3306/offline_polling_db"

# Throw-away database used only by `prisma migrate dev` to check migrations.
# Prisma wipes it on every run, so never point this at real data.
SHADOW_DATABASE_URL="mysql://polling_app:sjjm@ctuG!26@localhost:3306/offline_polling_shadow"
